rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ───────────────────────────────────────────
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Schema guard for user-owned documents. A new document may contain
    // only [fields]; an update may only change [fields] (fields written by
    // older app versions are left alone, so their documents still sync).
    function onlyFields(fields) {
      return resource == null
        ? request.resource.data.keys().hasOnly(fields)
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // [field] is absent, null, or a string of at most [max] characters.
    function optString(field, max) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string
            && request.resource.data[field].size() <= max);
    }

    // [field] is absent, null, or a number between 0 and 1e12.
    function optAmount(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == null
        || (request.resource.data[field] is number
            && request.resource.data[field] >= 0
            && request.resource.data[field] < 1000000000000);
    }

    function ownerWrite(uid, fields) {
      return isOwner(uid) && onlyFields(fields);
    }

    // ── User profile + sub-collections ─────────────────────────────
    match /users/{uid} {

      allow read, delete: if isOwner(uid);
      allow create, update: if ownerWrite(uid,
          ['displayName', 'email', 'lastSyncTime', 'syncVersion'])
        && optString('displayName', 200)
        && optString('email', 320);

      // ── Core Financial Collections ───────────────────────────────

      // Transactions
      match /transactions/{txnId} {
        allow read, delete: if isOwner(uid);

        allow create, update: if ownerWrite(uid, ['amount', 'type', 'categoryId',
            'date', 'note', 'paymentMethod', 'isRecurring', 'recurringFrequency',
            'merchantName', 'taxCategory', 'source', 'accountId', 'updatedAt',
            'serverUpdatedAt', 'recurringRuleId', 'occurrenceDate',
            'sourceObservationId', 'sourceFingerprint'])
          && request.resource.data.keys().hasAll(['amount', 'type', 'categoryId', 'date'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount < 1000000000000
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.categoryId is string
          && request.resource.data.categoryId.size() <= 100
          && request.resource.data.date is timestamp
          && optString('note', 5000)
          && optString('merchantName', 500)
          && optString('taxCategory', 100)
          && optString('accountId', 200)
          && optString('sourceFingerprint', 200);
      }

      // Categories (custom only)
      match /categories/{catId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if ownerWrite(uid, ['id', 'name', 'iconCodePoint',
            'iconFontFamily', 'colorValue', 'isCustom', 'type', 'updatedAt'])
          && optString('name', 100)
          && optString('iconFontFamily', 100);
      }

      // Budgets
      match /budgets/{budgetId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if ownerWrite(uid,
            ['id', 'categoryId', 'amount', 'month', 'year', 'updatedAt'])
          && optAmount('amount');
      }

      // Recurring Rules (automation engine)
      match /recurring_rules/{ruleId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if ownerWrite(uid, ['amount', 'type', 'categoryId',
            'note', 'paymentMethod', 'frequency', 'interval', 'startDate', 'endDate',
            'nextOccurrenceDate', 'lastGeneratedDate', 'isActive', 'merchantName',
            'taxCategory', 'source', 'accountId', 'createdAt', 'updatedAt', 'userId'])
          && optAmount('amount')
          && optString('note', 5000)
          && optString('merchantName', 500);
      }

      // Recurring Occurrences (generated ledger occurrences)
      match /recurring_occurrences/{occurrenceId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if ownerWrite(uid, ['ruleId', 'scheduledDate',
            'status', 'transactionId', 'generatedAt', 'updatedAt']);
      }

      // Tombstones (offline delete-wins synchronization)
      match /tombstones/{tombstoneId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if ownerWrite(uid, ['id', 'deletedAt', 'serverDeletedAt']);
      }

      // ── Premium Feature Collections ──────────────────────────────

      // Savings Goals
      match /saving_goals/{goalId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if ownerWrite(uid, ['id', 'name', 'targetAmount',
            'currentAmount', 'targetDate', 'createdAt', 'isPaused', 'emoji', 'updatedAt'])
          && optString('name', 200)
          && optString('emoji', 20)
          && optAmount('targetAmount')
          && optAmount('currentAmount');
      }

      // Recurring Payments (bills & subscriptions)
      match /recurring_payments/{paymentId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if ownerWrite(uid, ['id', 'merchantName', 'amount',
            'frequency', 'lastPaidAt', 'nextDueAt', 'categoryId', 'confidence',
            'source', 'status', 'isAutopay', 'previousAmount', 'priceChangeDetectedAt',
            'notes', 'createdAt', 'updatedAt', 'detectionReason'])
          && optString('merchantName', 500)
          && optString('notes', 5000)
          && optString('detectionReason', 1000)
          && optAmount('amount')
          && optAmount('previousAmount');
      }

      // Smart Alerts & Anomalies
      match /alerts/{alertId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if ownerWrite(uid, ['id', 'type', 'stage', 'severity',
            'title', 'message', 'alertKey', 'categoryId', 'amount', 'targetAmount',
            'ratio', 'transactionId', 'recurringPaymentId', 'goalId', 'period',
            'isRead', 'isDismissed', 'actionType', 'actionPayload', 'createdAt',
            'updatedAt', 'resolvedAt', 'expiresAt'])
          && optString('title', 500)
          && optString('message', 2000)
          && optString('actionPayload', 5000);
      }

      // Bill payment history (recurring payments ledger)
      match /recurring_payment_history/{historyId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if ownerWrite(uid, ['id', 'recurringPaymentId',
            'amount', 'paidAt', 'source', 'transactionId', 'notes', 'createdAt'])
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && optAmount('amount')
          && optString('notes', 5000);
      }

      // Weekly planner limits
      match /weekly_limits/{limitId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if ownerWrite(uid, ['id', 'categoryId', 'categoryName',
            'weeklyLimit', 'createdAt', 'updatedAt', 'isActive', 'periodStart',
            'recurrencePolicy'])
          && request.resource.data.weeklyLimit is number
          && request.resource.data.weeklyLimit >= 0
          && optAmount('weeklyLimit')
          && optString('categoryName', 100);
      }

      // User reports about AI Copilot replies (Play AI-Generated Content policy).
      // Write-once; the user can read/delete their own reports.
      match /ai_reports/{reportId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['reply', 'prompt', 'reason', 'createdAt'])
          && request.resource.data.reply is string
          && request.resource.data.reply.size() <= 5000
          && request.resource.data.prompt is string
          && request.resource.data.prompt.size() <= 2000
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 100;
      }

      // Read and delete anything else in the user's subtree (legacy collections
      // such as linked_accounts, tax_categories and family_members, which the
      // app no longer writes) so account deletion can wipe it all.
      match /{document=**} {
        allow read, delete: if isOwner(uid);
      }
    }

    // ── Shared household budgets ───────────────────────────────────
    // Up to 6 members share monthly category budgets. Each member publishes
    // only their own monthly category totals (never transactions). People
    // join with an invite code; nobody can add someone else.
    function signedIn() {
      return request.auth != null;
    }
    // Guests (Firebase anonymous auth) can't create households; creating one
    // is a Premium feature and requires a Google account.
    function isRegisteredUser() {
      return signedIn()
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }
    function householdData(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }
    function isHouseholdMember(hid) {
      return signedIn() && request.auth.uid in householdData(hid).memberUids;
    }
    function isHouseholdOwner(hid) {
      return signedIn() && householdData(hid).ownerUid == request.auth.uid;
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function validMemberNames() {
      return request.resource.data.memberNames.keys().hasOnly(request.resource.data.memberUids);
    }
    function validInvite(code, hid) {
      let invite = get(/databases/$(database)/documents/householdInvites/$(code)).data;
      return invite.householdId == hid && invite.expiresAt > request.time;
    }

    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      // Premium-only, enforced here: the Worker copies the RevenueCat
      // entitlement onto the ID token as a `premium` claim (/premium/claim).
      allow create: if isRegisteredUser()
        && request.auth.token.get('premium', false) == true
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'memberUids', 'memberNames', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.memberNames.keys().hasOnly([request.auth.uid])
        && request.resource.data.memberNames[request.auth.uid] is string
        && request.resource.data.memberNames[request.auth.uid].size() <= 40
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;

      allow update: if signedIn() && (
        // Any member can rename the household.
        (request.auth.uid in resource.data.memberUids
          && changedOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40)
        // A member (not the owner) can leave.
        || (request.auth.uid in resource.data.memberUids
          && request.auth.uid != resource.data.ownerUid
          && changedOnly(['memberUids', 'memberNames'])
          && request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid])
          && validMemberNames())
        // The owner can remove other members.
        || (resource.data.ownerUid == request.auth.uid
          && changedOnly(['memberUids', 'memberNames'])
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && validMemberNames())
        // Someone with a valid invite code can add themselves (only).
        || (!(request.auth.uid in resource.data.memberUids)
          && changedOnly(['memberUids', 'memberNames', 'lastInviteCode'])
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
          && request.resource.data.memberUids.size() <= 6
          && validMemberNames()
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.memberNames[request.auth.uid] is string
          && request.resource.data.memberNames[request.auth.uid].size() <= 40
          && validInvite(request.resource.data.lastInviteCode, hid))
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Shared monthly budget per category.
      match /budgets/{categoryId} {
        allow read, delete: if isHouseholdMember(hid);
        allow create, update: if isHouseholdMember(hid)
          && request.resource.data.keys().hasOnly(['categoryId', 'categoryName', 'amount', 'updatedBy', 'updatedAt'])
          && request.resource.data.categoryId == categoryId
          && request.resource.data.categoryName is string
          && request.resource.data.categoryName.size() <= 40
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.amount < 1000000000
          && request.resource.data.updatedBy == request.auth.uid;
      }

      // One member's category totals for one month: id "<uid>_<yyyyMM>".
      match /spending/{docId} {
        allow read: if isHouseholdMember(hid);
        allow create, update: if isHouseholdMember(hid)
          && docId.matches(request.auth.uid + '_[0-9]{6}')
          && request.resource.data.keys().hasOnly(['uid', 'month', 'byCategory', 'names', 'total', 'updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.month is string
          && request.resource.data.month.size() <= 7
          && request.resource.data.byCategory is map
          && request.resource.data.byCategory.size() <= 100
          && request.resource.data.names is map
          && request.resource.data.names.size() <= 100
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.total < 1000000000000;
        // Your own totals (even after leaving), or anything for the owner
        // (deleting the household).
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid
          || householdData(hid).ownerUid == request.auth.uid);
      }
    }

    // Invite codes: whoever knows a code can look it up (it is the secret);
    // codes can be listed by their creator or by the household's owner, and
    // expire within 8 days. The owner can revoke any code for the household
    // (e.g. after removing a member, so they can't re-join with it).
    match /householdInvites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && (resource.data.createdBy == request.auth.uid
        || isHouseholdOwner(resource.data.householdId));
      allow create: if signedIn()
        && code.matches('[A-Z2-9]{8}')
        && request.resource.data.keys().hasOnly(['householdId', 'createdBy', 'expiresAt'])
        && request.resource.data.createdBy == request.auth.uid
        && isHouseholdMember(request.resource.data.householdId)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd');
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid
        || isHouseholdOwner(resource.data.householdId));
    }

    // Deny all other access (default-deny)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
