rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ───────────────────────────────────────────
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── User profile + sub-collections ─────────────────────────────
    match /users/{uid} {

      // Only the signed-in user can read/write their own profile doc
      allow read, write: if isOwner(uid);

      // ── Core Financial Collections ───────────────────────────────

      // Transactions
      match /transactions/{txnId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && request.resource.data.keys().hasAll(['amount', 'type', 'categoryId', 'date'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.type in ['income', 'expense'];

        allow update: if isOwner(uid)
          && request.resource.data.keys().hasAll(['amount', 'type', 'categoryId', 'date'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.type in ['income', 'expense'];

        allow delete: if isOwner(uid);
      }

      // Categories
      match /categories/{catId} {
        allow read, write: if isOwner(uid);
      }

      // Budgets
      match /budgets/{budgetId} {
        allow read, write: if isOwner(uid);
      }

      // Recurring Rules (automation engine)
      match /recurring_rules/{ruleId} {
        allow read, write: if isOwner(uid);
      }

      // Recurring Occurrences (generated ledger occurrences)
      match /recurring_occurrences/{occurrenceId} {
        allow read, write: if isOwner(uid);
      }

      // Tombstones (offline delete-wins synchronization)
      match /tombstones/{tombstoneId} {
        allow read, write: if isOwner(uid);
      }

      // ── Premium Feature Collections ──────────────────────────────

      // Savings Goals
      match /saving_goals/{goalId} {
        allow read, write: if isOwner(uid);
      }

      // Recurring Payments
      match /recurring_payments/{paymentId} {
        allow read, write: if isOwner(uid);
      }

      // Smart Alerts & Anomalies
      match /alerts/{alertId} {
        allow read, write: if isOwner(uid);
      }

      // Tax Deduction Buckets
      match /tax_categories/{taxCatId} {
        allow read, write: if isOwner(uid);
      }

      // Linked Accounts (Bank / Aggregator Integration)
      match /linked_accounts/{accId} {
        allow read, write: if isOwner(uid);
      }

      // Family Members / Group Sharing
      match /family_members/{memberId} {
        allow read, write: if isOwner(uid);
      }

      // Bill payment history (recurring payments ledger)
      match /recurring_payment_history/{historyId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0;
      }

      // Weekly planner limits
      match /weekly_limits/{limitId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.weeklyLimit is number
          && request.resource.data.weeklyLimit >= 0;
      }

      // User reports about AI Copilot replies (Play AI-Generated Content policy).
      // Write-once; the user can read/delete their own reports.
      match /ai_reports/{reportId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['reply', 'prompt', 'reason', 'createdAt'])
          && request.resource.data.reply is string
          && request.resource.data.reply.size() <= 5000
          && request.resource.data.prompt is string
          && request.resource.data.prompt.size() <= 2000
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 100;
      }

      // Allow deletion and read of any other legacy or auxiliary document within the user's subtree
      // (ensures account deletion can cleanly wipe all orphaned subcollections)
      match /{document=**} {
        allow read, delete: if isOwner(uid);
      }
    }

    // ── Shared household budgets ───────────────────────────────────
    // Up to 6 members share monthly category budgets. Each member publishes
    // only their own monthly category totals (never transactions). People
    // join with an invite code; nobody can add someone else.
    function signedIn() {
      return request.auth != null;
    }
    function householdData(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }
    function isHouseholdMember(hid) {
      return signedIn() && request.auth.uid in householdData(hid).memberUids;
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function validMemberNames() {
      return request.resource.data.memberNames.keys().hasOnly(request.resource.data.memberUids);
    }
    function validInvite(code, hid) {
      let invite = get(/databases/$(database)/documents/householdInvites/$(code)).data;
      return invite.householdId == hid && invite.expiresAt > request.time;
    }

    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'memberUids', 'memberNames', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.memberNames.keys().hasOnly([request.auth.uid])
        && request.resource.data.memberNames[request.auth.uid] is string
        && request.resource.data.memberNames[request.auth.uid].size() <= 40
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;

      allow update: if signedIn() && (
        // Any member can rename the household.
        (request.auth.uid in resource.data.memberUids
          && changedOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40)
        // A member (not the owner) can leave.
        || (request.auth.uid in resource.data.memberUids
          && request.auth.uid != resource.data.ownerUid
          && changedOnly(['memberUids', 'memberNames'])
          && request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid])
          && validMemberNames())
        // The owner can remove other members.
        || (resource.data.ownerUid == request.auth.uid
          && changedOnly(['memberUids', 'memberNames'])
          && resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && validMemberNames())
        // Someone with a valid invite code can add themselves (only).
        || (!(request.auth.uid in resource.data.memberUids)
          && changedOnly(['memberUids', 'memberNames', 'lastInviteCode'])
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
          && request.resource.data.memberUids.size() <= 6
          && validMemberNames()
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.memberNames[request.auth.uid] is string
          && request.resource.data.memberNames[request.auth.uid].size() <= 40
          && validInvite(request.resource.data.lastInviteCode, hid))
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Shared monthly budget per category.
      match /budgets/{categoryId} {
        allow read, delete: if isHouseholdMember(hid);
        allow create, update: if isHouseholdMember(hid)
          && request.resource.data.keys().hasOnly(['categoryId', 'categoryName', 'amount', 'updatedBy', 'updatedAt'])
          && request.resource.data.categoryId == categoryId
          && request.resource.data.categoryName is string
          && request.resource.data.categoryName.size() <= 40
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.amount < 1000000000
          && request.resource.data.updatedBy == request.auth.uid;
      }

      // One member's category totals for one month: id "<uid>_<yyyyMM>".
      match /spending/{docId} {
        allow read: if isHouseholdMember(hid);
        allow create, update: if isHouseholdMember(hid)
          && docId.matches(request.auth.uid + '_[0-9]{6}')
          && request.resource.data.keys().hasOnly(['uid', 'month', 'byCategory', 'names', 'total', 'updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.month is string
          && request.resource.data.byCategory is map
          && request.resource.data.byCategory.size() <= 100
          && request.resource.data.names is map
          && request.resource.data.total is number;
        // Your own totals (even after leaving), or anything for the owner
        // (deleting the household).
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid
          || householdData(hid).ownerUid == request.auth.uid);
      }
    }

    // Invite codes: whoever knows a code can look it up (it is the secret);
    // codes can't be listed except your own, and expire within 8 days.
    match /householdInvites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn()
        && code.matches('[A-Z2-9]{8}')
        && request.resource.data.keys().hasOnly(['householdId', 'createdBy', 'expiresAt'])
        && request.resource.data.createdBy == request.auth.uid
        && isHouseholdMember(request.resource.data.householdId)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd');
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Deny all other access (default-deny)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
