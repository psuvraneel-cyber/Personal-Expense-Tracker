<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive local database from cloud backups to protect user financial history -->
        <exclude domain="database" path="pet_tracker.db" />
        <exclude domain="database" path="pet_tracker.db-journal" />
        <exclude domain="database" path="pet_tracker.db-shm" />
        <exclude domain="database" path="pet_tracker.db-wal" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude sensitive local database from device-to-device transfers to prevent leakage -->
        <exclude domain="database" path="pet_tracker.db" />
        <exclude domain="database" path="pet_tracker.db-journal" />
        <exclude domain="database" path="pet_tracker.db-shm" />
        <exclude domain="database" path="pet_tracker.db-wal" />
    </device-transfer>
</data-extraction-rules>
