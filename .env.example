# The AI Copilot model is chosen by the Cloudflare Worker (GROQ_MODEL in
# cloudflare_worker/wrangler.toml); the app no longer needs to set it.

# ── RevenueCat Public SDK Keys ───────────────────────────────────────────────
# Injected at build time via: flutter [run|build] --dart-define-from-file=.env
#
# DEBUG / DEVELOPMENT builds:
# Use the Test Store Public API Key (starts with test_) from RevenueCat Dashboard.
REVENUECAT_TEST_STORE_API_KEY=test_your_test_store_public_key_here

# RELEASE / PRODUCTION builds:
# Use the Google Play Android Public API Key (starts with goog_) from RevenueCat Dashboard.
# NEVER put Test Store keys or Secret API keys (sk_*) in release builds.
REVENUECAT_ANDROID_API_KEY=goog_your_google_play_public_key_here
