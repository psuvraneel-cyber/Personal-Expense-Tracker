<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing is backed up or copied to a new phone.
     The SQLCipher database lives in app_flutter/ (root domain), its key is
     bound to this device's Keystore, and the Firestore cache in databases/ is
     unencrypted, so a transferred copy is useless at best and a privacy leak
     at worst. A new phone restores from the cloud after sign-in instead.
     (allowBackup="false" does not stop device-to-device transfer on 12+.) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
